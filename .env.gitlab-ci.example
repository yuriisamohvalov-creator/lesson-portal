# GitLab CI/CD — переменные окружения
# Скопируйте значения в GitLab → Settings → CI/CD → Variables
#
# Локальный деплой (develop → deploy:local)
LOCAL_DEPLOY_DIR=/home/ysamohvalov/service/lessons-portal-local
LOCAL_ENV_FILE=/home/ysamohvalov/service/lessons-portal-local/.env
#
# Prod деплой (main → deploy:prod, manual)
BRIX_PC_HOST=brix-pc
BRIX_PC_USER=ysamohvalov
BRIX_PC_DEPLOY_DIR=/home/ysamohvalov/service/lessons-portal
# SSH_PRIVATE_KEY — добавить как File variable в GitLab UI (не коммитить!)
# SSH_KNOWN_HOSTS — опционально: ssh-keyscan brix-pc
