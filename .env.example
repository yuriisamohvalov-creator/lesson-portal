# Backend
PORT=3001

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lessons_portal
POSTGRES_USER=lessons_user
POSTGRES_PASSWORD=change_me_postgres

# MinIO
# Host path for object storage (default: ./minio_data in project root)
# MINIO_DATA_DIR=/var/lib/lessons-portal/minio
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET=lessons-videos
MAX_VIDEO_SIZE_MB=5000
PDF_IMPORT_MAX_MB=20
# Colon-separated absolute paths on the backend host (must be mounted into the backend container)
# VIDEO_CATALOG_IMPORT_ROOTS=/data/lessons-import:/mnt/plex/lessons

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=change_me_jwt_secret
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret
JWT_EXPIRES_IN=15m

# Frontend
# Leave empty for local dev — browser uses same-origin /api via Next.js proxy
NEXT_PUBLIC_API_URL=
FRONTEND_URL=http://localhost:3002
