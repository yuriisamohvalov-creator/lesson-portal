# Production environment for brix-pc / lessons.samoh.ru
# Copy to .env on the server. Encrypt secrets with deploy/secrets.sh (master key on brix only).
#
# One-time:
#   ./deploy/secrets.sh gen-key
#   cp .env.production.example .env.plain
#   # edit plaintext secrets in .env.plain
#   ./deploy/secrets.sh encrypt-env .env.plain .env
#   shred -u .env.plain   # or rm securely
#
# Secrets below MUST be ENC(...) — never plaintext on disk in prod .env.

PORT=3001

# Prebuilt images (overridden by CI deploy each release; keep placeholders)
BACKEND_IMAGE=gitlab.local:5050/yurii.samohvalov/lesson-portal/backend:main
FRONTEND_IMAGE=gitlab.local:5050/yurii.samohvalov/lesson-portal/frontend:main

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lessons_portal
POSTGRES_USER=lessons_user
POSTGRES_PASSWORD=ENC(replace_with_secrets_sh_encrypt)

# MinIO (internal only in prod)
MINIO_DATA_DIR=/home/ysamohvalov/data/lessons-portal/minio
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=https://lessons.samoh.ru
# Browser uploads use /api/storage/* (proxied by backend to MinIO)
STORAGE_PUBLIC_ENDPOINT=https://lessons.samoh.ru/api/storage
MINIO_PORT=3072
MINIO_REGION=us-east-1
MINIO_ROOT_USER=ENC(replace_with_secrets_sh_encrypt)
MINIO_ROOT_PASSWORD=ENC(replace_with_secrets_sh_encrypt)
MINIO_BUCKET=lessons-videos
MAX_VIDEO_SIZE_MB=5000

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT — generate plaintext: openssl rand -hex 32, then secrets.sh encrypt
JWT_SECRET=ENC(replace_with_secrets_sh_encrypt)
JWT_REFRESH_SECRET=ENC(replace_with_secrets_sh_encrypt)
JWT_EXPIRES_IN=15m

# Public URLs
NEXT_PUBLIC_API_URL=https://lessons.samoh.ru
FRONTEND_URL=https://lessons.samoh.ru

# Host ports (localhost only, nginx proxies 443)
BACKEND_PORT=3071
FRONTEND_PORT=3070

COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
